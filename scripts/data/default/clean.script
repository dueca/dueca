# -*-sh-*-
# this file cleans all temporary run files and also the symbolic links
# from the data directory

# clean dueca stuff
clean-dueca-rundir

# clean all symbolic links
find . -type l -exec rm {} \;

# clean run script
rm -f runscript

# clean the user's stuff (that's you, you have to add your commands here!)

# also clean all result files if specified
if [ "$1" = "--all" ]; then

    # folder with run results
    rm -rf runlogs

    # user's additional files, if not moved to runlogs

fi